[Unit]
Description=EDCMON - EAR Data Center Monitor service
#ConditionPathExists=/var/ear
#Wants=req1.service req2.service
#After=req1.service req2.service


[Service]
Type=simple
Environment="EAR_ETC=/home/julitac/ear4.3.1-intel.dev/etc"
Environment="EDCMON_PLUGINS=metrics.so:30000+periodic_metrics.so:30000"
ExecStart=/home/julitac/ear4.3.1-intel.dev/sbin/edcmon --plugins=$EDCMON_PLUGINS
ExecStop=/bin/kill -TERM $MAINPID
KillMode=process
Restart=on-failure
#RestartSec=1s
LimitMEMLOCK=infinity
LimitSTACK=infinity

[Install]
WantedBy=multi-user.target

