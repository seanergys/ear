[Unit]
Description=EDCMON - EAR Data Center Monitor service
#ConditionPathExists=@localstatedir@
#Wants=req1.service req2.service
#After=req1.service req2.service


[Service]
Type=simple
Environment="EAR_ETC=@sysconfdir@"
Environment="EDCMON_PLUGINS=metrics.so:30000+periodic_metrics.so:30000"
ExecStart=@prefix@/sbin/edcmon --plugins=$EDCMON_PLUGINS
ExecStop=/bin/kill -TERM $MAINPID
KillMode=process
Restart=on-failure
#RestartSec=1s
LimitMEMLOCK=infinity
LimitSTACK=infinity

[Install]
WantedBy=multi-user.target

