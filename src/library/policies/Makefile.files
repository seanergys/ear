poli_OBJS = \
    policy.o

stan_OBJS = \
    pc_suport.o \
    gpu_support.o \
    cpu_support.o \
		mpi_stats_support.o \
		imc_policy_support.o

stan_BINS = \
    min_energy.so \
    min_time.so  \
    min_time_no_models.so \
    min_energy_no_models.so \
    monitoring.so 

ifeq ($(FEAT_MPI_API), 1)
ifeq ($(FEAT_RESEARCH),1)
stan_BINS += \
    load_balance.so
endif
endif
#app_min_time.so \
#app_monitoring.so \
#app_min_energy.so \

ifdef CUDA_BASE
stan_BINS += \
    gpu_monitoring.so 

ifeq ($(FEAT_GPU_OPT),1)
stan_BINS += \
    gpu_min_energy.so
endif
endif

eard_BINS = \
    min_time_eard.so \
    min_energy_eard.so \
    monitoring_eard.so 

ifeq ($(FEAT_MPI_API), 1)
ifeq ($(FEAT_RESEARCH),1)
eard_BINS += \
    load_balance_eard.so
endif
endif
