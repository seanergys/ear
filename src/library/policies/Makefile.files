poli_OBJS = \
    policy.o

stan_OBJS = \
    pc_suport.o \
    gpu_support.o \
    cpu_support.o \
    mpi_stats_support.o \
    imc_policy_support.o

stan_BINS = \
    min_energy.so \
    min_time.so  \
    monitoring.so 


ifdef CUDA_BASE
stan_BINS += \
    gpu_monitoring.so 

ifeq ($(FEAT_GPU_OPT),1)
stan_BINS += \
    gpu_min_energy.so \
	gpu_min_time.so
endif
endif

eard_BINS = \
    min_time_eard.so \
    min_energy_eard.so \
    monitoring_eard.so 
