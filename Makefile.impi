# Features
# Compiles the MPI EAR library version or non-MPI
FEAT_MPI_API       = 1
# This is automatically generated based on the CPU version detected
FEAT_AVX512        = 1
# Extend the set of files installed.
FEAT_RESEARCH      = 0
# Enables the installation of GPU optimization policies. If 0, only monitoring is supported.
FEAT_GPU_OPT       = 0
# Disables the utilization of virtual PSTATES in AMD and selects OS CPUFreq
FEAT_AMD_OSCPUFREQ = 0
# Uses mysql API
FEAT_DB_MYSQL      = 1
# Uses Postgress API
FEAT_DB_PSQL       = 0

# Compilers
CC           = /hpc/base/intel/compilers_and_libraries_2020.4.304/linux/bin/intel64/icc
CC_FLAGS     = -static-intel -Werror-all
MPICC        = /hpc/base/intel/inteloneapi/mpi/2021.2.0/bin/mpiicc
MPICC_FLAGS  = -static-intel -Werror-all

# Includes
MPI_BASE     = /hpc/base/intel/inteloneapi/mpi/2021.2.0
MPI_CFLAGS   = -I$(MPI_BASE)/include
MPI_VERSION  = 
GSL_BASE     = /usr
GSL_CFLAGS   = 
GSL_LDFLAGS  =  -lm -lgsl -lgslcblas
SLURM_BASE   = /hpc/base/ctt/build/slurm-21.08.4
SLURM_CFLAGS = -I$(SLURM_BASE)
DB_BASE      = /usr
DB_CFLAGS    = -I/usr/include
DB_LDFLAGS   = -L/usr/lib64/mysql -lmysqlclient
CUDA_BASE    = /hpc/base/cuda/cuda-10.1
# Define if Likwid must be used
LIKWID_BASE  = /hpc/base/ctt/packages/likwid/5.2.1
# Used for the energy plugin inm_power
FREEIPMI_BASE=

# Directories
ROOTDIR      = $(shell pwd)
SRCDIR       = $(ROOTDIR)/src
DESTDIR      = /home/xjcorbalan/ear4.0
ETCDIR       = /home/xjcorbalan/ear4.0/etc
TMPDIR       = /var/ear
DOCDIR       = /share/doc/ear

# Installation
CHOWN_USR    = xjcorbalan
CHOWN_GRP    = 
#CONSTANTS   = -DSEC_KEY=10001 -DSYN_TEST # Define SYN_TEST for external synthetic tests compilation
CONSTANTS    = -DSEC_KEY=10001
REPLACE      =

######## EXPORTS

include ./Makefile.exports

######## RULES

.PHONY: check functionals

all:
	@ $(MAKE) -C 'src' all || exit

full: clean all 

check:
	@ $(MAKE) -C 'src' check

install:
	@ $(MAKE) -C 'etc' install || exit
	@ $(MAKE) -C 'src' install || exit

clean:
	@ $(MAKE) -C 'src' clean || exit

######## ADDITIONAL RULES

devel.install: install;
	@ $(MAKE) -C 'etc' devel.install || exit
	@ $(MAKE) -C 'src' devel.install || exit

etc.install: ;
	@ $(MAKE) -C 'etc' etc.install || exit
	@ $(MAKE) -C 'src' etc.install || exit

rpm.install: install;
	@ $(MAKE) -C 'etc' rpm.install || exit

scripts.install: ;
	@ $(MAKE) -C 'etc' scripts.install || exit

doc.install: ;
	@ $(MAKE) -C 'doc' install || exit 

%.build: ;
	@ $(MAKE) -C 'src' $*.build || exit

%.install: ;
	@ $(MAKE) -C src $*.install || exit

########

depend:
	@ $(MAKE) -C 'src' depend || exit

depend-clean:
	@ $(MAKE) -C 'src' depend-clean || exit
